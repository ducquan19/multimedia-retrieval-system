# Backend (pydantic-settings reads AIC_* variables; full list in backend/src/core/config.py)
AIC_DATA_ROOT=./data
AIC_FRONTEND_ORIGIN=http://localhost:5173
AIC_MAX_TRAKE_EVENTS=10
AIC_MAX_QUERY_LENGTH=4000
AIC_MAX_ANSWER_LENGTH=4000
AIC_LOG_LEVEL=INFO
# cuda | cpu; empty = automatic
AIC_DEVICE=

# Frontend. Leave API base empty in local development to use the Vite proxy.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:8000

# Query enhancement / KIS planning with Google Gemini (google-genai).
# Empty = Enhance query disabled (searches fall back to the raw query).
AIC_GEMINI_API_KEY=
AIC_GEMINI_MODEL=gemini-3.5-flash-lite

# Elasticsearch (ASR BM25), see docker-compose.yml
AIC_ES_URL=http://localhost:9200

# BLIP-2 reranking of the top AIC_RERANK_DEPTH candidates (slow without a GPU)
AIC_ENABLE_RERANKING=false
AIC_RERANK_DEPTH=100

# TRAKE: sequences whose every event shows the same moment (same shot, or within this many
# seconds) are merged into the best one, so results are not near-copies. 0 = off.
AIC_TRAKE_DEDUP_SECONDS=2

# DRES submission server (https://eventretrieval.one)
AIC_DRES_USERNAME=
AIC_DRES_PASSWORD=

# Read-only Hugging Face token for the private video repository
AIC_HF_TOKEN=
