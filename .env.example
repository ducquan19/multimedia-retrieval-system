# Backend (pydantic-settings reads AIC_* variables)
AIC_DATA_ROOT=./data
AIC_FRONTEND_ORIGIN=http://localhost:5173
AIC_DEFAULT_TOP_K=20
AIC_MAX_TRAKE_EVENTS=10

# Frontend. Leave API base empty in local development to use the Vite proxy.
VITE_API_BASE_URL=
VITE_DEV_API_TARGET=http://localhost:8000

# Reserved for a future provider adapter. The MVP never reads or calls Gemini.
GEMINI_API_KEY=replace-me-in-a-local-env-file
